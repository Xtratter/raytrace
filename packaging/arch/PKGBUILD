# Maintainer: Xtratter
pkgname=raytrace
pkgver=1.3.0
pkgrel=1
pkgdesc='Real-time SDF ray tracer (Rust, wgpu/Vulkan) with an egui settings panel'
arch=('x86_64')
url='https://github.com/Xtratter/raytrace'
license=('Apache-2.0')
depends=('vulkan-icd-loader' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver/rust"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver/rust"
  cargo build --frozen --release --features desktop --bin raytrace-desktop
}

check() {
  cd "$pkgname-$pkgver/rust"
  cargo test --frozen --lib --features desktop
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 rust/target/release/raytrace-desktop "$pkgdir/usr/bin/raytrace"
  install -Dm644 packaging/linux/raytrace.desktop "$pkgdir/usr/share/applications/raytrace.desktop"
  install -Dm644 packaging/linux/raytrace.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/raytrace.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
